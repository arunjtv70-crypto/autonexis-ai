{
  "version": 2,
  "buildCommand": "node build.js",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api/|assets/|brand/|fonts/|icons/|screenshots/|\\.well-known/|robots\\.txt|sitemap\\.xml|favicon.*|icon-.*|logo.*|apple-touch-.*|manifest.*|sw\\.js|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
