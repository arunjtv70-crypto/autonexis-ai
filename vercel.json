{
  "buildCommand": "node build.js",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api/|assets/|brand/|fonts/|favicon.*|icon-.*|logo.*|apple-touch-.*|manifest.*|sw\\.js|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
