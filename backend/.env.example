# ==========================================
# AUTONEXIS Assistant - Configuration Template
# ==========================================
# Any OpenAI-compatible provider can be plugged in:
#
# For Groq:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
#
# For OpenAI:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
#
# For DeepSeek:
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

LLM_API_KEY=your_api_key_here
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1

APP_NAME=AUTONEXIS Assistant
HOST=127.0.0.1
PORT=8000

# Security & JWT Session
JWT_SECRET=autonexis_super_secret_jwt_key_2026_change_in_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Auth Providers Config (Strictly in backend only)
GOOGLE_CLIENT_ID=autonexis-google-client-id.apps.googleusercontent.com
SMS_API_KEY=mock_or_your_sms_gateway_key
SMS_OTP_EXPIRY_MINUTES=5
SMS_MAX_FAILED_ATTEMPTS=5
SMS_LOCKOUT_MINUTES=15

# Database URL (SQLite default)
DATABASE_URL=sqlite+aiosqlite:///./autonexis.db

SYSTEM_PROMPT=तुम 'ऑटोनेक्सिस असिस्टेंट' (AUTONEXIS Assistant) हो। तुम्हें ऑटोनेक्सिस (Autonexis) द्वारा विकसित किया गया है।
